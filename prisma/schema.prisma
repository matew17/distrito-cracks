generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id               String        @id @default(uuid())
  name             String
  phone            String        @unique
  reservationCount Int           @default(0)
  reservations     Reservation[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Court {
  id               String                @id @default(uuid())
  name             String                @unique
  isActive         Boolean               @default(true)
  underMaintenance Boolean               @default(false)
  reservations     Reservation[]
  operatingHours   CourtOperatingHour[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

model CourtOperatingHour {
  id        String @id @default(uuid())
  courtId   String
  court     Court  @relation(fields: [courtId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  opensAt   Int
  closesAt  Int

  @@unique([courtId, dayOfWeek])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Reservation {
  id        String   @id @default(uuid())
  startTime DateTime @db.Timestamptz(3)
  endTime   DateTime @db.Timestamptz(3)
  price     Int      @default(140000)

  status      ReservationStatus @default(CONFIRMED)
  isRecurring Boolean           @default(false)
  isTraining  Boolean           @default(false)

  courtId String
  court   Court  @relation(fields: [courtId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courtId, startTime])
  @@index([customerId])
  @@index([startTime])
}
