# Matches the credentials in docker-compose.yml
DATABASE_URL="postgresql://admin:password@localhost:5432/distritocracks?schema=public"
PORT=3000

# Venue's local timezone, used to evaluate BR-03 (operating hours) in
# venue-local weekday/time regardless of the host process's TZ setting
# (see specs/001-court-reservations/research.md R4).
VENUE_TIMEZONE=America/Bogota
